<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>로그인</title>
</head>
<body>
  <h2>로그인</h2>

  <% if (error) { %>
    <p style="color: red;"><%= error %></p>
  <% } %>

  <form method="POST" action="/login">
    <p><input name="username" placeholder="아이디" required></p>
    <p><input type="password" name="password" placeholder="비밀번호" required></p>
    <button>로그인</button>
  </form>

  <p><a href="/signup">회원가입 하러 가기</a></p>
</body>
</html>