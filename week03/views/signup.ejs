<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>회원가입</title>
</head>
<body>
  <h2>회원가입</h2>

  <% if (error) { %>
    <p style="color: red;"><%= error %></p>
  <% } %>

  <form method="POST" action="/signup">
    <p><input name="username" placeholder="아이디" required></p>
    <p><input type="password" name="password" placeholder="비밀번호" required></p>
    <button>가입하기</button>
  </form>

  <p><a href="/login">로그인으로 돌아가기</a></p>
</body>
</html>